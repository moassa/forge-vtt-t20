  "system": {
    "description": {
      "value": "<p style=\"text-align:justify\">Um bardo, nobre ou sábio que ajuda com palavras firmes ou encorajadoras.</p><p style=\"text-align:justify\">Iniciante: você recebe +2 em duas perícias.</p><p style=\"text-align:justify\">Veterano: muda para +2 em três perícias.</p><p style=\"text-align:justify\">Mestre: muda para +4 em três perícias.</p><p style=\"text-align:justify\">As perícias são definidas pelo parceiro. Um ajudante não pode fornecer bônus em Luta ou Pontaria.</p>",
      "unidentified": ""
    },
