{
  "name": "tormenta20",
  "version": "1.0.0",
  "description": "CSS compiler for the tormenta20 system",
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -cw",
    "build:packs": "node ./utils/fvtt-pack.mjs",
    "build:unpack": "node ./utils/fvtt-unpack.mjs",
    "build:ci": "npm run build:packs && rollup -c",
    "lint": "eslint --ext .js,.cjs,.mjs .",
    "lint:fix": "eslint --ext .js,.cjs,.mjs --fix .",
    "lint:warnings": "eslint --max-warnings 0 --ext .js,.cjs,.mjs .",
    "lint:errors": "eslint --quiet --ext .js,.cjs,.mjs .",
    "lint:fix:errors": "eslint --quiet --ext .js,.cjs,.mjs --fix .",
    "postinstall": "npm run build:ci",
    "update-manifest": "node ./utils/update-manifest.js"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "John Doe",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "@guanghechen/rollup-plugin-copy": "^6.0.0",
    "@html-eslint/eslint-plugin": "^0.26.0",
    "@html-eslint/parser": "^0.26.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "chalk": "^5.4.1",
    "eslint": "^10.2.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "less": "^4.6.4",
    "autoprefixer": "^10.4.21",
    "rollup": "^4.59.0",
    "rollup-plugin-postcss": "^4.0.2",
    "showdown": "^2.1.0"
  }
}
