<header class="header-character flexrow">
  <img src="{{document.img}}"
    data-action="editImage" data-field-path="img">
  <div class="grid">
    <div class="name">
      {{formInput
        document.schema.fields.name 
        value=document.name
      }}
    </div>
    <aside class="flexrow">
      <button class="inline-control icon fa-solid fa-heart" data-action="configResource" data-tooltip="T20.LevelConfig"></button>
      <button class="inline-control icon fa-solid fa-bed" data-action="configRest" data-tooltip="T20.Rest"></button>
      <span class="level">
        {{localize "T20.Level"}}
        {{source.system.attributes.nivel.value}}
      </span>
      {{#if xp}}
        <div class="flexrow xp">
          {{!-- TODO --}}
        </div>
      {{/if}}
    </aside>
    <div class="identity flexrow">
      {{log "sheet" this}}
      {{#each identity as | identity type |}}
        <div class="{{type}} flexrow" data-tooltip="{{localize identity.typeLabel}}">
          {{#if identity.field}}
            {{formInput
            identity.field
            value=identity.value
          }}
          {{else}}
            {{#each identity.items as | item | }}
              <a data-action="edit" data-entry-id="{{item.id}}" data-embedded="item">
                {{item.name}}
              </a>
            {{else}}
              <span>{{localize identity.typeLabel}}</span>
              <button class="inline-control icon fa-solid fa-plus" data-action="addItem" data-type="{{type}}"></button>
            {{/each}}
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
</header>
<style>
  .tormenta20-v2.sheet.character .header-character {
    img {
      width: 100px;
      flex: 0 0 100px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 1fr);

      .name {
        grid-column: span 3 / span 3;
      }

      aside {
        grid-column-start: 4;
        text-align: center;

        .level {}
      }

      .identity {
        grid-column: span 4 / span 4;
      }
    }
  }
</style>