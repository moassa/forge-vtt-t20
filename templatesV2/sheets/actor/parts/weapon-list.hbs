<ul class="plain embedded-list">
  <header class="flexrow">
    <div class="flex3">{{localize "T20.Weapons"}}</div>
    <div class="attack">
      {{localize "T20.Attack"}} ({{localize "T20.Damage"}}, {{localize "T20.Critical"}})
    </div>
    <div class="controls">

    </div>
  </header>
  {{#each weapons as | item |}}
    <li class="flexrow entry" data-entry-id="{{item.id}}">
      <div class="embedded item flex3">
        <img src="{{item.source}}" data-action="roll" data-tooltip="T20.Roll">
        <label> {{item.name}} </label>
      </div>
      <div class="attack">
        {{item.labels.toHit}} ({{item.labels.damage}}, {{item.labels.critico}})
      </div>
      <div class="controls">
        <button class="inline-control icon fa-solid fa-hand"
          data-action="toggle"
          data-entry-id="{{item.id}}"
          data-field-path="system.equipado"></button>
      </div>
    </li>
  {{/each}}
</ul>