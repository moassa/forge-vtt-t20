<ul class="plain item-list">
  <header>
    {{#each list.fields as | label key | }}
      <div class="{{key}}">{{label}}</div>
    {{/each}}
  </header>
  {{#each list.entries as | item |}}
    <li class="item" data-entry-id="{{item.id}}">
      <div class="img"></div>
      <div class="name"></div>
      <div class="prop"></div>
      <div class="controls"></div>
    </li>
  {{/each}}
</ul>