<div class="resource flexcol">
  <div>{{localize label}}</div>
  <div class="flexrow">
    {{formInput
      schema.fields.value 
      value=source.value
      dataset=(object tooltip=schema.fields.value.label)
    }} /
    {{formInput
      schema.fields.max
      value=resource.max
      dataset=(object tooltip=schema.fields.max.label)
      disabled=true
    }}
  </div>
  {{#if schema.fields.temp}}
    <div class="">
      {{formInput
        schema.fields.temp
        value=source.temp
        dataset=(object tooltip=schema.fields.temp.label)
      }}
    </div>
  {{/if}}
</div>